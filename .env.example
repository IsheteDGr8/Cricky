# Copy to .env.local. None of these are required for `npm run web:emulator`.

# Point the app at the local Firebase emulators (never production).
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Firebase App Check (web). Create the reCAPTCHA Enterprise key in the Firebase console.
# Do not enforce App Check on the live database until the v1 site is retired.
# EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
# EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=true

# Sentry (free tier). Leave unset to skip crash reporting.
# EXPO_PUBLIC_SENTRY_DSN=
